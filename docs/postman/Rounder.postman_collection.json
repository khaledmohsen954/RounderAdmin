  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dates are generated only when no explicit value is supplied.",
          "const day = Date.now() + 86400000;",
          "for (const [key, offset] of [[\"scheduled_at\",0],[\"starts_at\",0],[\"ends_at\",3600000]]) {",
          " if (!pm.variables.get(key)) pm.variables.set(key,new Date(day+offset).toISOString());",
          "}",
          "const raw = pm.request.url.toString() + (pm.request.body?.raw || \"\");",
          "const missing = [...raw.matchAll(/{{([a-zA-Z_][a-zA-Z0-9_]*)}}/g)].map(m=>m[1]).filter(k=>!String(pm.variables.get(k) ?? \"\").trim());",
          "if (pm.request.auth?.type !== \"noauth\" && !String(pm.variables.get(\"token\") ?? \"\").trim()) missing.push(\"token\");",
          "if (missing.length) throw new Error(\"Fill environment variables first: \" + [...new Set(missing)].join(\", \"));",
          ""
        ]
      }
    }
  ],
